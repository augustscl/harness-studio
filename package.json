{
  "name": "harness-studio",
  "version": "0.6.0",
  "description": "A polished macOS desktop client for DeepSeek Harness",
  "license": "MIT",
  "author": "Harness Studio contributors",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build:app": "electron-vite build",
    "build": "npm run typecheck && npm run build:app",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "check": "npm run typecheck && npm run test:run && npm run build:app",
    "postinstall": "node scripts/prepare-plugins.mjs && node scripts/fetch-pnpm-runtime.mjs && electron-builder install-app-deps",
    "icon": "bash scripts/build-icon.sh",
    "audit:bundle": "bash scripts/audit-bundle.sh",
    "smoke:packaged": "bash scripts/smoke-packaged.sh",
    "manifest": "node scripts/generate-build-manifest.mjs",
    "dist:mac": "npm run check && npm run test:e2e && npm run icon && electron-builder --mac dmg zip --arm64 && npm run audit:bundle && npm run smoke:packaged && npm run manifest",
    "dist:win": "npm run build:app && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@standard-schema/spec": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@harness/file-upload": "file:vendor/file-upload",
    "@harness/dsh-skin": "file:vendor/dsh-skin",
    "@harness/artifact-studio": "file:vendor/artifact-studio",
    "@harness/studio-ux": "file:vendor/studio-ux",
    "@harness/desktop-services": "file:vendor/desktop-services",
    "dshmarket": "file:vendor/dshmarket"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.harnessstudio.desktop",
    "productName": "Harness Studio",
    "copyright": "Copyright © 2026 Harness Studio contributors",
    "asar": false,
    "files": [
      "out/**/*",
      "package.json",
      "upload.patch.yml",
      "LICENSE",
      "THIRD_PARTY.md",
      "node_modules/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md",
      "!node_modules/**/{test,tests,__tests__,spec,example,examples,benchmark,benchmarks}/**/*",
      "!node_modules/**/.cache/**"
    ],
    "electronLanguages": [
      "en",
      "zh_CN",
      "zh_TW",
      "ja",
      "ko",
      "fr",
      "de",
      "es",
      "it",
      "pt_BR",
      "pt_PT",
      "ru",
      "nl",
      "pl",
      "tr",
      "ar",
      "he",
      "hi",
      "th",
      "vi",
      "id",
      "ms",
      "uk",
      "cs"
    ],
    "extraResources": [
      {
        "from": "resources/dsh-bootstrap.cjs",
        "to": "runtime/dsh-bootstrap.cjs"
      },
      {
        "from": "node_modules/@standard-schema/spec",
        "to": "app/node_modules/@standard-schema/spec"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/runtime/pnpm/macos-arm64",
          "to": "runtime/pnpm/macos-arm64"
        }
      ]
    },
    "dmg": {
      "format": "UDZO",
      "filesystem": "HFS+",
      "backgroundColor": "#111318",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 205,
          "type": "file"
        },
        {
          "x": 430,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/runtime/pnpm/win-x64",
          "to": "runtime/pnpm/win-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "afterPack": "scripts/after-pack-sign.cjs"
  },
  "optionalDependencies": {
    "node-addon-require-builtin-win32-x64-msvc": "0.1.4"
  }
}
